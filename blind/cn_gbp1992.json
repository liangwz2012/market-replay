":1.4914,"c":1.499,"volume":70858},{"date":"1993-03-26","o":1.499,"h":1.5084,"l":1.496,"c":1.5068,"volume":70184},{"date":"1993-03-29","o":1.5068,"h":1.5085,"l":1.5022,"c":1.5049,"volume":80676},{"date":"1993-03-30","o":1.5049,"h":1.5094,"l":1.4984,"c":1.4993,"volume":76454},{"date":"1993-03-31","o":1.4993,"h":1.5093,"l":1.4919,"c":1.502,"volume":73429}],"epilogue":{"masterName":"老索与老德","masterMove":"五年后泰铢脱钩，1992 的剧本在亚洲重演","lesson":"这场战役真正的天才之处不是预测英镑会贬值——半个伦敦都这么想——而是算清赔率：ERM 区间把空头的最大亏损封在约 1%（区间反弹+利差成本），而破位的收益是 15%~30%。当输赢如此不对称，正确动作是把仓位加到风险预算的上限。«你说对的时候，要下重注»——看对不重仓，等于白看对。"},"blindBriefing":{"kicker":"匿名研究简报","title":"一个被政治承诺强行钉在固定区间、基本面已失衡的发达国家货币","summary":"高调死守的固定汇率与经济现实背离，央行弹药远小于市场。","objective":"先读宏观、产业、资金、情绪，再把判断交给盘面验证。","cards":[{"label":"宏观环境","title":"为政治目标维持固定汇率","body":"为加入区域货币机制，承诺把汇率钉在窄区间，利率被迫维持高位。","tone":"risk"},{"label":"产业结构","title":"通胀更高、竞争力被侵蚀","body":"本国通胀长期高于锚定国，累积侵蚀竞争力，高利率压垮经济与就业。","tone":"bear"},{"label":"资金面","title":"干预弹药 vs 市场体量悬殊","body":"央行可用储备相对全球外汇日成交量微不足道，硬扛代价极高。","tone":"pressure"},{"label":"情绪","title":"官方越承诺、市场越试探","body":"「绝不贬值」的反复表态，反而吸引投机资本逼近防线下限。","tone":"bear"}]},"researchBriefing":{"kicker":"复盘版完整情报","title":"英镑兑美元（GBP/USD）","summary":"英镑（GBP），1990 年 10 月以 2.95 马克的中心汇率加入欧洲汇率机制（ERM），承诺将英镑兑德国马克维持在 ±6% 区间内，区间下限 2.7780","cards":[{"label":"背景","title":"英镑兑美元（GBP/USD）","body":"1992 年市场的主流信仰是：ERM 不可动摇。英镑入约是英国「拥抱欧洲、根治通胀」的政治背书，英德两国央行有义务联手捍卫区间，历史上 ERM 内的投机冲击也屡屡被击退。主流叙事认为，只要英国政府决心足够（加息+干预），汇率就守得住——「不"},{"label":"数据","title":"通胀差（英国 vs 德国 CPI）","body":"英国通胀长期高于德国数个百分点，累积侵蚀英镑实际竞争力"},{"label":"数据","title":"英德利差与失业率","body":"英国基准利率 10% 仍高于经济承受力，失业率约 10% 且在上升；德国坚持高利率抗统一后通胀"},{"label":"数据","title":"干预弹药 vs 市场体量","body":"英国外汇储备约 440 亿美元 vs 全球外汇日成交约万亿美元"},{"label":"数据","title":"ERM 区间下限（防线位置）","body":"2.7780 马克——价格离下限越近，防守成本越高、市场试探越密"}]}}