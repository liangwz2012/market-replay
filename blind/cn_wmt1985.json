,"h":10.742,"l":10.72,"c":10.735,"volume":6301109},{"date":"1995-10-18","o":11.331,"h":11.466,"l":11.229,"c":11.411,"volume":6854589},{"date":"1995-11-09","o":11.595,"h":11.605,"l":11.239,"c":11.266,"volume":1284467},{"date":"1995-12-01","o":11.964,"h":12.097,"l":11.728,"c":11.9,"volume":6752146},{"date":"1995-12-25","o":12.027,"h":12.084,"l":11.574,"c":11.698,"volume":5291348},{"date":"1995-12-29","o":11.437,"h":11.464,"l":11.228,"c":11.267,"volume":4239165}],"epilogue":{"masterName":"老林","masterMove":"回望沃尔玛十年约十六倍的复利曲线，老林的判断被逐年兑现：看懂、买入、拿住，外加在增速边际递减时的清醒重估","lesson":"1985 年的沃尔玛市盈率（PE）18 倍，比 Kmart 的 8 倍贵一倍，华尔街据此判它「太贵」。但老林用市盈率增长比（PEG = PE ÷ 增长率）一量：18 ÷ 30 约等于 0.6，远低于 1，是明显的折扣。被「比同行贵一倍」吓退的人，错过的是一只十倍股。给成长股估值，永远要把市盈率和增长率放在一起看——脱离增速谈车价，是成长股投资里最贵的一课。"},"blindBriefing":{"kicker":"匿名研究简报","title":"一家把单店模型复制到极致、成长跑道极长的折扣零售连锁","summary":"复制型高成长 + 真实成本护城河，唯一的「瑕疵」是估值不便宜。","objective":"先读宏观、产业、资金、情绪，再把判断交给盘面验证。","cards":[{"label":"宏观环境","title":"大众折扣消费长期扩张","body":"在大城市看不上的小镇扎根，错位竞争、需求稳定且可全国复制。","tone":"bull"},{"label":"产业结构","title":"自建配送的成本护城河","body":"自建配送中心 + 信息系统，单店模型已验证可盈利复制，ROE 30%+。","tone":"bull"},{"label":"资金面","title":"营收复合增速 30%+","body":"收入连年高速增长，远超行业个位数，门店数仍有数倍扩张空间。","tone":"bull"},{"label":"情绪","title":"「看上去就贵」劝退捡便宜者","body":"市盈率约 18 倍，是同业的两倍，传统估值派嫌贵而错过这只长跑冠军。","tone":"risk"}]},"researchBriefing":{"kicker":"复盘版完整情报","title":"沃尔玛（WMT）","summary":"沃尔玛（Walmart），美国折扣零售连锁，由山姆·沃尔顿 1962 年创立、1972 年上市。核心生意极其朴素：在大城市看不上的小镇上开「天天平价（Every","cards":[{"label":"背景","title":"沃尔玛（WMT）","body":"1985 年的主流叙事对沃尔玛是「贵且土」。它市盈率（PE）约 18 倍，而老牌折扣零售商 Kmart 只有 8 倍、Sears 约 10 倍——多数分析师据此判定沃尔玛「已经透支了未来」。看空的逻辑听上去很硬：折扣零售是出了名的烂生意，毛"},{"label":"数据","title":"营收（1984 财年）","body":"约 66 亿美元，近年复合增速 30%+，远高于行业个位数增长"},{"label":"数据","title":"门店数","body":"约 700+ 家（1985），主要集中在中南部小镇；到 1990 年已超 1500 家、覆盖全美"},{"label":"数据","title":"净资产收益率（ROE）","body":"约 30%+，显著高于 Kmart、Sears 等同业"},{"label":"数据","title":"市盈率（PE）","body":"约 18 倍（1985），同期 Kmart 约 8 倍、Sears 约 10 倍"}]}}