07},{"date":"1971-12-21","o":85.095,"h":89.782,"l":83.831,"c":88.705,"volume":550475},{"date":"1972-02-10","o":76.51,"h":77.083,"l":76.148,"c":76.668,"volume":888988},{"date":"1972-04-03","o":87.369,"h":89.511,"l":87.202,"c":88.684,"volume":6037029},{"date":"1972-05-24","o":79.457,"h":80.082,"l":78.397,"c":79.809,"volume":3006655},{"date":"1972-07-14","o":84.232,"h":87.478,"l":83.26,"c":85.928,"volume":2296039},{"date":"1972-09-05","o":84.941,"h":88.895,"l":84.186,"c":88.409,"volume":7928538},{"date":"1972-10-26","o":82.787,"h":83.388,"l":81.19,"c":81.266,"volume":2660579},{"date":"1972-12-18","o":87.949,"h":92.666,"l":87.634,"c":91.58,"volume":2846288},{"date":"1972-12-29","o":84.183,"h":84.526,"l":80.067,"c":80.411,"volume":3714151}],"epilogue":{"masterName":"祖师爷","masterMove":"祖师爷离世，享年 82 岁。他被公认为「价值投资之父」，其安全边际、内在价值、市场先生三大思想，至今仍是全球价值投资者的共同语言","lesson":"祖师爷年轻时把安全边际窄化成「低于净流动资产打折买入」，于是 GEICO 在他眼里「不符合标准」。但他最终承认：安全边际的本质是「价格远低于内在价值（Intrinsic Value）」，而内在价值不只是账面价值，更是未来现金流的折现。一桩能以 40% 复利增长、成本碾压同行的好生意，把它二十年的现金流折现回来，远高于 1948 年的市值——这个差额，才是最厚的安全边际。脱离生意、只看账面谈贵贱，是价值投资里最贵的一课。"},"blindBriefing":{"kicker":"匿名研究简报","title":"一家成本结构碾压同行、净利高速增长的小保险公司","summary":"结构性成本护城河 + 优质客群，但体量小、且违反分散原则。","objective":"先读宏观、产业、资金、情绪，再把判断交给盘面验证。","cards":[{"label":"宏观环境","title":"行业格局稳定、需求刚性","body":"车险是刚需，行业格局成熟，龙头靠模式而非周期取胜。","tone":"bull"},{"label":"产业结构","title":"直销模式砍掉中间成本","body":"绕开代理人，费用率比传统对手低 15%-20%，是结构性、可持续的优势。","tone":"bull"},{"label":"资金面","title":"净利近五年复合增长约 40%","body":"体量虽小，但盈利高速增长、承保客群出险率结构性偏低。","tone":"bull"},{"label":"情绪","title":"不符合「捡烟蒂」的传统标准","body":"账面价值低、不便宜，传统价值派会嫌它「贵」而错过。","tone":"risk"}]},"researchBriefing":{"kicker":"复盘版完整情报","title":"GEICO（政府雇员保险公司）","summary":"GEICO（Government Employees Insurance Company，政府雇员保险公司），1936 年由利奥·古德温（Leo Goodwin","cards":[{"label":"背景","title":"GEICO（政府雇员保险公司）","body":"1948 年，主流对 GEICO 的看法是「太小、太贵、不安全」。它账面价值低、净流动资产更低，作为一家成长中的保险公司还需要不断补充资本金应对承保扩张——用祖师爷自己《证券分析》里的捡烟蒂（净流动资产打折买入）标尺去量，它根本不及格。看空"},{"label":"数据","title":"净利润（1947）","body":"约 70 万美元，体量很小，但近五年净利复合增长约 40%"},{"label":"数据","title":"费用率优势","body":"比传统代理人模式的车险公司低约 15%-20%，结构性、可持续"},{"label":"数据","title":"承保人群","body":"主攻政府雇员等出险率低、信用稳定的客户，赔付率结构性低于全市场"},{"label":"数据","title":"祖师爷-纽曼建仓","body":"1948 年以约 71 万美元买入 GEICO 约 50% 股权，占基金约 25%——违反分散原则的一辈子最大单笔"}]}}