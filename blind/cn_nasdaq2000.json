te":"2000-12-27","o":2502.22,"h":2521.41,"l":2445.38,"c":2473.1,"volume":1124900},{"date":"2000-12-28","o":2473.1,"h":2478.02,"l":2465.38,"c":2469.71,"volume":1190378},{"date":"2000-12-29","o":2469.71,"h":2484.16,"l":2464.37,"c":2470,"volume":1709982}],"epilogue":{"masterName":"老虎","masterMove":"纳斯达克较顶部腰斩、价值股全面正名，老虎「理性终将回归」的判断被完整兑现，但他已不在场","lesson":"1999 到 2000 年，做空泡沫的判断完全正确——纳斯达克从 5048 跌回 2470。但在它兑现之前，价格继续疯涨了半年，把提前做空的人轧到浮亏、赎回、清盘。老虎在 3-30 离场，崩盘在 4-14 开始。正确从来不是一个时点的对错，而是一段时间的存活：你必须在判断兑现之前，先活下来。"},"blindBriefing":{"kicker":"匿名研究简报","title":"一个被「新经济」叙事推到史诗级估值的科技股市场","summary":"估值彻底脱离盈利，市值/GDP 创历史峰值，烧钱公司被疯抢。","objective":"先读宏观、产业、资金、情绪，再把判断交给盘面验证。","cards":[{"label":"宏观环境","title":"「新经济」叙事接管定价权","body":"新技术被视为蒸汽机级革命，盈利与现金流被认为「不重要」。","tone":"bull"},{"label":"产业结构","title":"估值脱离盈利的极值","body":"板块市盈率冲上百倍量级、龙头市销率超 30 倍，剔除亏损股仍处历史极值。","tone":"risk"},{"label":"资金面","title":"流动性宽松 + IPO 狂潮","body":"宽松货币与打新热钱涌入，没有利润的公司也能翻倍上市。","tone":"pressure"},{"label":"情绪","title":"市值/GDP 创历史峰值","body":"整体市值占 GDP 突破历史前高，全民炒科技，看空者被当成落伍者。","tone":"bear"}]},"researchBriefing":{"kicker":"复盘版完整情报","title":"纳斯达克综合指数","summary":"本局标的是 1999 年末的美国股市组合：纳斯达克综合指数（2740 点附近、年末冲破 4000）为泡沫的温度计，可交易品种包括泡沫科技龙头思科（CSCO）、被","cards":[{"label":"背景","title":"纳斯达克综合指数","body":"1999 年末的主流叙事是「新经济（New Economy）」：互联网将重写一切商业规则，旧的估值标尺——市盈率、现金流、净资产——被宣布过时。卖方分析师用「市梦率（Price-to-Dream）」「每个眼球多少美元」给没有利润的网络公司定"},{"label":"数据","title":"纳斯达克综合指数","body":"约 2740 点（1999-09），年末冲破 4000，2000-03-10 见顶 5048"},{"label":"数据","title":"纳斯达克整体市盈率（PE）","body":"约 150-200 倍，剔除亏损公司后仍处历史极值；标普 500 同期约 30 倍"},{"label":"数据","title":"思科（Cisco）估值","body":"市盈率超 100 倍，市销率超 30 倍——2000 年 3 月一度成为全球市值第一的公司（约 5500 亿美元）"},{"label":"数据","title":"美股市值 / GDP（巴菲特指标）","body":"突破 150%，创历史峰值，远高于 1929 年与 1968 年的前高"}]}}