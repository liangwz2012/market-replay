h":17.844,"l":17.504,"c":17.8,"volume":1743917}],"blindBriefing":{"kicker":"匿名研究简报","title":"困境制造业的救援交易","summary":"市场把注意力放在更热门的行业上，这类传统公司显得慢、旧、不性感。可真正的投资机会有时藏在不起眼的单位经济里。","objective":"先判断这家公司所在行业是否有可复制、可防守、能长期产生现金流的结构。","cards":[{"label":"宏观环境","title":"经济并不完美，估值分化明显","body":"通胀、利率或衰退担忧让市场更挑剔，传统行业容易被低估。","tone":"neutral"},{"label":"产业结构","title":"慢行业也可能有强生意","body":"传统制造业景气低迷，债务、工会、库存和政策救援共同决定生死。","tone":"neutral"},{"label":"资金面","title":"热门资金不在这里","body":"机构更喜欢高增长故事，冷门行业的错误定价反而更容易存在。","tone":"bear"},{"label":"行业消息","title":"利多是经营改善，利空是行业老化","body":"关键看增长是否来自真实现金流，而不是一次性题材。","tone":"neutral"}]},"researchBriefing":{"kicker":"开盘前情报","title":"1982：克莱斯勒","summary":"美国第三大汽车公司距破产一步, 国会刚通过 $15 亿担保","objective":"先读环境，再定交易计划。行情会自己证明你有没有退路。","cards":[{"label":"背景","title":"克莱斯勒","body":"美国第三大汽车公司距破产一步, 国会刚通过 $15 亿担保","tone":"neutral"},{"label":"标的","title":"克莱斯勒","body":"股价:$3.50；市值:$8 亿 (历史新低)；1981 净亏损:-$4.8 亿；政府担保:$15 亿 (1980 国会通过)；CEO:Lee Iacocca (前福特总裁)；救命产品:K-Car (50 MPG, 与丰田同等)；1986 年克莱斯勒涨到 $…","tone":"policy"},{"label":"价格","title":"3.854 → 17.8","body":"回放区间 1982-04-01 至 1989-12-31，价格变化约 361.9%。","tone":"bull"},{"label":"情绪","title":"市场有分歧","body":"林奇, 克莱斯勒过去 5 年没赚一分钱. 政府担保不能改变美国造车不行这件事. 我做空克莱斯勒已经 1 年了.","tone":"risk"}]},"epilogue":{"masterName":"彼得·林奇","masterMove":"克莱斯勒 1982 政府担保贷款 + 新车型 K-Car. 林奇当时占麦哲伦 5% 仓 (基金最高), 3 年 ×11 倍.","lesson":"危机救援股最大的优势: 大多数机构因为风控规定不能买. 这给个人投资人一个不公平的优势——你可以买他们不能买的."}}