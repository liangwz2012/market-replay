57,"c":3877,"volume":2725826},{"date":"2017-08-30","o":3801,"h":3906,"l":3761,"c":3884,"volume":1685551},{"date":"2017-08-31","o":3884,"h":4027,"l":3871,"c":4007,"volume":614735}],"blindBriefing":{"kicker":"匿名研究简报","title":"过剩行业里的供给收缩","summary":"你看到的是一个长期产能过剩行业突然遇到政策出清。需求未必很强，但供给端的变化可能让价格剧烈重估。","objective":"重点不是猜经济多好，而是判断供给收缩是否足以改变库存和预期。","cards":[{"label":"宏观环境","title":"传统投资放缓，政策开始托底","body":"地产和基建都不算轻松，宏观层面更强调去库存、去产能和稳增长。","tone":"policy"},{"label":"产业结构","title":"黑色产业链分化","body":"钢厂、矿石、贸易商和终端需求互相拉扯，利润会在链条中快速转移。","tone":"neutral"},{"label":"资金面","title":"期货资金嗅到拐点","body":"产业资金谨慎，投机资金开始关注库存下降和限产预期。","tone":"bull"},{"label":"市场情绪","title":"没人相信过剩行业能大涨","body":"多数人仍用熊市思维看待周期品，越不相信，趋势形成后越容易被迫追认。","tone":"bear"}]},"researchBriefing":{"kicker":"开盘前情报","title":"2015：上期所螺纹钢 (RB)","summary":"2015 年底螺纹钢跌到十年低点, 钢厂全行业亏损 645 亿","objective":"先读环境，再定交易计划。行情会自己证明你有没有退路。","cards":[{"label":"背景","title":"上期所螺纹钢 (RB)","body":"2015 年底螺纹钢跌到十年低点, 钢厂全行业亏损 645 亿","tone":"neutral"},{"label":"标的","title":"上期所螺纹钢 (RB)","body":"螺纹钢现货价:1700-1900 元/吨, 跌破成本线；全国粗钢产能:约 12 亿吨, 实际需求约 7 亿吨；钢厂现金流:全行业累计亏损 645 亿 (2015)；中央定调:供给侧结构性改革, 去产能去库存；环保压力:京津冀、长三角限产升级, 地条钢清退；需…","tone":"policy"},{"label":"价格","title":"1699 → 4007","body":"回放区间 2015-11-02 至 2017-08-31，价格变化约 135.8%。","tone":"bull"},{"label":"情绪","title":"市场有分歧","body":"葛总, 政策只是说说而已. 钢铁业是地方政府的财政支柱, 真要去产能, 各省都不会执行. 你赌的是\"中央能压地方\", 这是 5 年级别的赌注.","tone":"risk"}]},"epilogue":{"masterName":"葛卫东","masterMove":"葛卫东以 '宏观对冲' 闻名, 2015-2016 准确押注供给侧改革, 重仓黑色系一战封神.","lesson":"做期货先看政策。中央经济工作会议、发改委文件, 这些是国运级别的信号。看不懂宏观, 就别碰商品."}}